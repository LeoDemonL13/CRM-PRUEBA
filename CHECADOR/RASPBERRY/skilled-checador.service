[Unit]
Description=Skilled Checador local-first
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/skilled-checador
ExecStart=/opt/skilled-checador/.venv/bin/python /opt/skilled-checador/app.py
Restart=always
RestartSec=3
User=skilled
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
